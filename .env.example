# Copy to .env and adjust. docker compose reads .env automatically.

# mock (default): canned AI output, no API key needed.
# real: calls Claude; the api exits on startup if ANTHROPIC_API_KEY is empty.
LLM_MODE=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Limit for each AI call (Go duration).
LLM_TIMEOUT=60s

# Password for the seeded demo login marketer@marketer.com.
# Read only on the first seed; local use only. At least 8 characters.
DEMO_MARKETER_PASSWORD=Demo1234!

# Password of the mock provider's own database role (D6). At least 8 characters.
PROVIDER_DB_PASSWORD=provider-demo

# Mock provider behaviour per channel (D20 defaults). Rates are fractions of
# requests; a "timeout" hangs past the worker's 5 s limit, then is accepted.
PROVIDER_SEED=1
SMS_DELAY_MS_MIN=20
SMS_DELAY_MS_MAX=200
SMS_ERROR_RATE=0.05
SMS_RATE_LIMIT_RATE=0.03
SMS_TIMEOUT_RATE=0.01
EMAIL_DELAY_MS_MIN=20
EMAIL_DELAY_MS_MAX=200
EMAIL_ERROR_RATE=0.05
EMAIL_RATE_LIMIT_RATE=0.03
EMAIL_TIMEOUT_RATE=0.01

# Local demo database credentials.
POSTGRES_PASSWORD=scc
